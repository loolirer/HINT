<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hint_bringup</name>
  <version>0.0.0</version>
  <description>HINT bringup — launch and visualization configuration</description>
  <maintainer email="lorenzo.oliveira@ee.ufcg.edu.br">loolirer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>hint_behavior</exec_depend>
  <exec_depend>hint_narrative</exec_depend>
  <exec_depend>hint_navigation</exec_depend>
  <exec_depend>hint_perception</exec_depend>
  <exec_depend>hint_vlm</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
