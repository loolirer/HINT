<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hint_perception</name>
  <version>0.0.0</version>
  <description>HINT perception: semantic ground segmentation (ground_segmenter) — an
    ONNX/OpenVINO model whose non-ground cells are projected into an obstacle
    PointCloud2 (/ground/obstacles) for the mapless Nav2 local costmap.</description>
  <maintainer email="lorenzo.oliveira@ee.ufcg.edu.br">loolirer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <test_depend>ros-jazzy-compressed-image-transport</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
