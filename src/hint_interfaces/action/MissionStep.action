# Goal — advance to the next actionable step in the loaded mission (no fields)
---
# Result
bool mission_done    # true when no actionable steps remain (mission complete)
string description   # the step instruction to feed trajectory_planner (empty when mission_done)
string area          # current area id (empty when mission_done)
string step_id       # current step id (empty when mission_done)
string message       # note: replan explanation, or the mission-complete summary
---
# Feedback
string state         # "RUNNING" while (re)planning
