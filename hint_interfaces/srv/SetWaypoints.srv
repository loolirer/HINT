# Ordered ground-plane waypoints in normalized image space: point.x, point.y in
# [-1, 1] (center = 0; left/top = -1, right/bottom = +1); z unused. waypoints[0]
# is the first (nearest) waypoint, waypoints[-1] the last (farthest). Matches the
# layout of PlanTrajectory.markers so a trajectory_planner result feeds straight in.
geometry_msgs/Point[] waypoints
# Frame to initialise tracking on; {sec: 0, nanosec: 0} uses the next frame.
builtin_interfaces/Time stamp
---
bool accepted
string message
