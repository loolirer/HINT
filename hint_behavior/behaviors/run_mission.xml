<?xml version="1.0"?>
<root BTCPP_format="4">
  <BehaviorTree ID="RunMission">
    <Fallback>
      <KeepRunningUntilFailure>
        <Sequence>
          <MissionAdvance mission_path="{mission_path}" success="{last_ok}"
                          waypoints="{waypoints}" turn_degrees="{turn_degrees}" stamp="{stamp}"
                          mission_failed="{mission_failed}"/>
          <Fallback>
            <Sequence>
              <FollowVisualPathAction waypoints="{waypoints}" stamp="{stamp}"/>
              <SpinAction yaw_degrees="{turn_degrees}"/>
              <SetBlackboard output_key="last_ok" value="true"/>
            </Sequence>
            <SetBlackboard output_key="last_ok" value="false"/>
          </Fallback>
        </Sequence>
      </KeepRunningUntilFailure>
      <Precondition if="mission_failed" else="SUCCESS">
        <AlwaysFailure/>
      </Precondition>
    </Fallback>
  </BehaviorTree>
</root>
