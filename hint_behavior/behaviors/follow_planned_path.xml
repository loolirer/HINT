<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="FollowPlannedPath">
      <Sequence>
        <PlanPathAction description="{description}" images="{images}" markers="{markers}" turn_degrees="{turn_degrees}" stamp="{stamp}" message="{plan_message}"/>
        <FollowPathAction waypoints="{markers}" stamp="{stamp}"/>
        <!-- Always spin by the VLM's turn. 0deg completes instantly (Nav2 Spin succeeds
             on the first cycle when target == 0), so any turn value is a success; only
             the physical spin failing (robot stuck) fails the move. -->
        <SpinAction yaw_degrees="{turn_degrees}"/>
      </Sequence>
    </BehaviorTree>
</root>
